#!/bin/bash
# Managed by Ansible (role postgresql) — INF-29864.
# TRUNCATE of the shard tables goes through truncate_table_guarded(), which is
# fail-closed: a partitioned table (relkind='p') or an inheritance parent is
# SKIPped and an unreachable database is a refusal, never a blind TRUNCATE.
# Rationale and the reference implementation: §7 of corezoid-partition-archive.md
# in the corezoid_update_manuals repository (separate repo, not this one).
PATH=${PATH}:/usr/pgsql-{{ db_version }}/bin

PGARGS="--port {{ db_port }}"
PGARGS2="-p {{ db_port }}"
PG_BIN_PATH="/usr/pgsql-{{ db_version }}/bin"
PG_DATA="{{ db_dir }}/{{ db_version }}/data/base"
SCRIPTS="{{ db_dir }}/scripts"

R_LOG="${SCRIPTS}/reglament.log"
PARTMAN_LOG="${SCRIPTS}/partman_maintenance.log"

cd ${SCRIPTS} || exit 1

# Retention scope. The default is deliberately the same ten shards the previous
# revision of this script used (`DBNAMES=$(echo cp{0..9})`): ten production
# environments declare a hundred shards in real_db_numbers (ff_kyrgyztan_prod*,
# ff_morocco_prod, ff_nigeria_prod, ff_vietnam_prod, corezoid.com, jusan-prod,
# ff_india_prod*…), and widening a nightly TRUNCATE to cp10–cp99 there is a
# per-environment decision, not a side effect of a template change. An environment
# that wants it sets `maintenance_shard_pattern` in its vars/box.yml (INF-30670:
# leobank_prod_new runs 25 shards per master, '^cp[0-9]+$' there resolves to exactly
# that master's cp0–cp24 / cp25–cp49 / … because the list is asked of pg_database).
# Single source for all three places the pattern is used: this query, the DBNAME
# override and its FATAL text.
SHARD_PATTERN='{{ maintenance_shard_pattern | default("^cp[0-9]$") }}'

# Asked of the server instead of assumed, so a shard that does not exist is left
# out instead of producing connection errors.
DBNAMES=$(psql ${PGARGS} -d postgres -Atc \
    "SELECT datname FROM pg_database WHERE datname ~ '${SHARD_PATTERN}' ORDER BY datname")

# Optional single-shard override: DBNAME=cp3 bash maintenance.sh truncate_tasks_history
# Validated twice — against the pattern (place 2 of 3) and against pg_database
# (place 3 of 3) — so a typo is a FATAL, never a silent full-fleet run.
if [ -n "${DBNAME:-}" ]; then
    DBNAME_RC=0
    if [[ "${DBNAME}" =~ ${SHARD_PATTERN} ]]; then
        DBNAME_FOUND=$(psql ${PGARGS} -d postgres -Atc \
            "SELECT 1 FROM pg_database WHERE datname = '${DBNAME}' AND datname ~ '${SHARD_PATTERN}'")
        DBNAME_RC=$?
    else
        DBNAME_FOUND=""
    fi
    if [ ${DBNAME_RC} -ne 0 ] || [ "${DBNAME_FOUND}" != "1" ]; then
        echo "FATAL: база '${DBNAME}' не існує або не відповідає шаблону ${SHARD_PATTERN}" >&2
        exit 1
    fi
    DBNAMES="${DBNAME}"
fi

# An empty shard list means the list was not obtained (server down, wrong port),
# not "nothing to do" — refuse rather than run a silent no-op.
require_dbnames(){
    [ -n "${DBNAMES}" ] || { echo "ОТКАЗ: список баз cp[0-9]+ пуст или не получен" >&2; return 1; }
}

# The role deploys the script and its crons on streaming standbys too (so a promoted
# standby has working retention without a playbook run). TRUNCATE / pg_repack /
# run_maintenance cannot run in recovery — each would fail and cron would mail the
# failure every night — so the writing subcommands print one line and exit 0 there.
# Only an explicit 't' is a standby: with the server down the check is false and the
# caller falls through to require_dbnames, which refuses as before.
skip_on_standby(){
    local IN_RECOVERY
    IN_RECOVERY=$(psql ${PGARGS} -d postgres -Atc "SELECT pg_is_in_recovery()" 2>/dev/null)
    if [ "${IN_RECOVERY}" = "t" ]; then
        echo "standby (pg_is_in_recovery = t): $1 пропущен, выполняется только на мастере"
        return 0
    fi
    return 1
}

check_exist_pgdb(){
    local DB
    DB="$1"
    nohup 1>/dev/null 2>/dev/null psql ${PGARGS} ${DB} -c 'select 1' || { echo "connection to ${DB} failed"; exit 1; }
}

# --- guard, fail closed -------------------------------------------------------

# prints relkind ('r' | 'p' | ...) or an empty string; rc != 0 = check did not happen
relkind_of(){
    psql ${PGARGS} -d "$1" -Atc \
        "SELECT c.relkind FROM pg_class c
          WHERE c.oid = to_regclass('$2')" 2>/dev/null
}

# prints the schema-qualified name; autovacuum writes it that way in pg_stat_activity
fqname_of(){
    psql ${PGARGS} -d "$1" -Atc \
        "SELECT n.nspname || '.' || c.relname FROM pg_class c
           JOIN pg_namespace n ON n.oid = c.relnamespace
          WHERE c.oid = to_regclass('$2')" 2>/dev/null
}

# prints the number of inheritance children; rc != 0 = check did not happen
children_of(){
    psql ${PGARGS} -d "$1" -Atc \
        "SELECT count(*) FROM pg_inherits WHERE inhparent = to_regclass('$2')" 2>/dev/null
}

truncate_table_guarded(){
    local DB TBL FQ KIND KIDS RC WRAP_PID
    DB="$1"; TBL="$2"
    KIND=$(relkind_of "${DB}" "${TBL}"); RC=$?
    if [ ${RC} -ne 0 ]; then
        echo "ОТКАЗ: ${DB}.${TBL} — проверка relkind не выполнена (psql rc=${RC}), TRUNCATE не выполняется" >&2
        return 1
    fi
    if [ "${KIND}" != "r" ]; then
        echo "SKIP: ${DB}.${TBL} не обычная таблица (relkind='${KIND:-нет объекта}'), TRUNCATE не выполняется"
        return 0
    fi
    # relkind='r' alone is not enough: an inheritance parent is an ordinary table
    # too, and TRUNCATE without ONLY empties its children as well. Same class of
    # accident as the partitioned parent, so the same fail-closed treatment.
    KIDS=$(children_of "${DB}" "${TBL}"); RC=$?
    if [ ${RC} -ne 0 ] || [ -z "${KIDS}" ]; then
        echo "ОТКАЗ: ${DB}.${TBL} — проверка наследования не выполнена (psql rc=${RC}), TRUNCATE не выполняется" >&2
        return 1
    fi
    if [ "${KIDS}" != "0" ]; then
        echo "SKIP: ${DB}.${TBL} — родитель наследования (потомков: ${KIDS}), TRUNCATE не выполняется"
        return 0
    fi
    # Without a name the LIKE below degenerates to "any wraparound autovacuum in
    # this database" and can return several pids — cancel nothing instead.
    FQ=$(fqname_of "${DB}" "${TBL}")
    if [ -n "${FQ}" ]; then
        WRAP_PID=$(psql ${PGARGS} -d "${DB}" -Atc "select pid from pg_stat_activity
            where datname = '${DB}'
              and query like 'autovacuum:%${FQ} (to prevent wraparound)' limit 1")
        [ -z "${WRAP_PID}" ] || psql ${PGARGS} -d "${DB}" -c "select pg_cancel_backend(${WRAP_PID})"
    fi
    psql ${PGARGS} -d "${DB}" -c "SET lock_timeout = '5s'; TRUNCATE ONLY ${TBL}"
}

# --- retention ----------------------------------------------------------------
# NOTE (INF-29864): on corezoid-dev the tasks_archive loop was removed from
# truncate_all by hand, because that shard set is partitioned by pg_partman and
# retention there is run_maintenance()'s job. The loop is kept HERE on purpose —
# for the environments whose tasks_archive is still a plain table it IS their
# retention, and on a partitioned one the guard turns it into a SKIP. So after a
# playbook run corezoid-dev will again walk tasks_archive and print SKIP ten
# times; that is expected, not a regression.

# Both loops keep going after a refusal (one unreachable shard must not stop
# retention on the rest) but report it: cron mails a non-empty exit status, so a
# permanently failing shard is visible instead of hiding behind rc=0.

truncate_all(){
    local RC=0
    skip_on_standby truncate_all && return 0
    require_dbnames || return 1
    for DBNAME in ${DBNAMES}
    do
        echo -n "${DBNAME} "
        truncate_table_guarded "${DBNAME}" tasks_archive || RC=1
    done
    for DBNAME in ${DBNAMES}
    do
        echo -n "${DBNAME} "
        truncate_table_guarded "${DBNAME}" tasks_history || RC=1
    done
    return ${RC}
}

truncate_tasks_history(){
    local RC=0
    skip_on_standby truncate_tasks_history && return 0
    require_dbnames || return 1
    for DBNAME in ${DBNAMES}
    do
        echo -n "${DBNAME} "
        truncate_table_guarded "${DBNAME}" tasks_history || RC=1
    done
    return ${RC}
}

# --- partman ------------------------------------------------------------------
# Walks the same ${DBNAMES}; a database without the pg_partman extension is
# skipped and a failure in one database does not break the loop. Logs to
# PARTMAN_LOG itself — the case branch below must therefore stay bare.

partman_maintenance(){
    local DB RC HAS_EXT FAILED
    FAILED=0
    skip_on_standby partman_maintenance && return 0
    if ! require_dbnames; then
        echo "$(date '+%F %T') ОШИБКА: список баз не получен, maintenance не выполнен" \
            | tee -a "${PARTMAN_LOG}" >&2
        return 1
    fi
    for DB in ${DBNAMES}; do
        HAS_EXT=$(psql ${PGARGS} -d "${DB}" -Atc \
            "SELECT 1 FROM pg_extension WHERE extname='pg_partman'"); RC=$?
        if [ ${RC} -ne 0 ]; then
            echo "$(date '+%F %T') ${DB}: ОШИБКА — проверка расширения не выполнена (rc=${RC})" \
                | tee -a "${PARTMAN_LOG}" >&2
            FAILED=1
            continue
        fi
        if [ "${HAS_EXT}" != "1" ]; then
            echo "$(date '+%F %T') ${DB}: pg_partman не установлен, пропуск" | tee -a "${PARTMAN_LOG}"
            continue
        fi
        echo "$(date '+%F %T') ${DB}: run_maintenance" | tee -a "${PARTMAN_LOG}"
        psql ${PGARGS} -d "${DB}" -c "SELECT partman.run_maintenance()" 2>&1 \
            | tee -a "${PARTMAN_LOG}"
        if [ ${PIPESTATUS[0]} -ne 0 ]; then
            echo "$(date '+%F %T') ${DB}: ОШИБКА run_maintenance" | tee -a "${PARTMAN_LOG}"
            FAILED=1
        fi
    done
    # cron sends stdout to /dev/null, so a non-zero status is the only thing that
    # distinguishes "retention ran" from "retention has been failing for a month"
    return ${FAILED}
}

# Read-only, so unlike retention it covers every shard (cp0–cp99), not SHARD_PATTERN;
# DBNAME=cpN still narrows it to one shard (INF-30500).
# pgstattuple_approx skips all-visible pages instead of reading the whole table:
# a full pgstattuple('tasks') on a standby outlives max_standby_streaming_delay and
# gets cancelled ("conflict with recovery"), so a cancelled shard is retried.
check_bloat_tables(){
    local BLOAT_DBNAMES TABLE RES TRY
    TABLE="tasks"
    if [ -n "${DBNAME:-}" ]; then
        BLOAT_DBNAMES="${DBNAMES}"
    else
        BLOAT_DBNAMES=$(psql ${PGARGS} -d postgres -Atc \
            "SELECT datname FROM pg_database WHERE datname ~ '^cp[0-9]+$' ORDER BY length(datname), datname")
    fi
    [ -n "${BLOAT_DBNAMES}" ] || { echo "ОТКАЗ: список баз cp[0-9]+ пуст или не получен" >&2; return 1; }
    for DB in ${BLOAT_DBNAMES}
    do
        check_exist_pgdb "${DB}"
        if [ "$(psql ${PGARGS} -d "${DB}" -Atc "SELECT 1 FROM pg_extension WHERE extname = 'pgstattuple'")" != "1" ]; then
            echo "${DB}|${TABLE}|SKIP: нет pgstattuple (CREATE EXTENSION pgstattuple на мастере)"
            continue
        fi
        for TRY in 1 2 3
        do
            RES=$(psql ${PGARGS} -d "${DB}" -Atc \
                "SELECT round(approx_free_percent::numeric, 2) FROM pgstattuple_approx('${TABLE}')" 2>&1) && break
            [ ${TRY} -lt 3 ] && sleep 5
        done
        [[ "${RES}" =~ ^[0-9.]+$ ]] || RES="ERROR: $(echo "${RES}" | head -1)"
        echo "${DB}|${TABLE}|${RES}"
    done
}

# --- repack -------------------------------------------------------------------
# Ported from the hand-maintained copy on UZ prod db-cz-shards-1 (INF-30670), where
# it has been running against live shards:
#  * ANY autovacuum on the table or its toast is cancelled (not only the anti-wraparound
#    one) — pg_repack needs an ACCESS SHARE-free moment to swap and a running autovacuum
#    holds it off until --wait-timeout expires;
#  * autovacuum_enabled is switched off on the table for the duration and RESET
#    afterwards — also on failure and on INT/TERM — so a repack never leaves a shard
#    without autovacuum;
#  * --no-kill-backend: on a timeout pg_repack gives up instead of terminating the
#    application's backends; --wait-timeout=120 as on UZ.
# Walks ${DBNAMES} (SHARD_PATTERN / DBNAME override) like retention does, and stops at
# the first failed shard: a half-repacked tier is something to look at, not to skip.

repack_av_reset(){
    psql ${PGARGS} -d "$1" -c "ALTER TABLE $2 RESET (autovacuum_enabled);"
}

repack_shards(){
    local TABLE FQ TOAST AV_PIDS AVPID REPACK_STATUS HAS_EXT
    TABLE="$1"
    skip_on_standby repack_shards && return 0
    require_dbnames || return 1
    for DBNAME in ${DBNAMES}
    do
        check_exist_pgdb "${DBNAME}"

        # pg_repack needs its extension in the database (CREATE EXTENSION pg_repack, out of band)
        HAS_EXT=$(psql ${PGARGS} -d "${DBNAME}" -Atc "SELECT 1 FROM pg_extension WHERE extname = 'pg_repack'")
        if [ "${HAS_EXT}" != "1" ]; then
            echo "ОТКАЗ: ${DBNAME} — расширение pg_repack не установлено (CREATE EXTENSION pg_repack), repack не выполняется" >&2
            return 1
        fi

        FQ=$(fqname_of "${DBNAME}" "${TABLE}")
        if [ -z "${FQ}" ]; then
            echo "ОТКАЗ: ${DBNAME}.${TABLE} — таблица не найдена, repack не выполняется" >&2
            return 1
        fi
        # toast relation, schema-qualified as autovacuum names it ("pg_toast.pg_toast_16385"); empty if none
        TOAST=$(psql ${PGARGS} -d "${DBNAME}" -Atc \
            "SELECT reltoastrelid::regclass::text FROM pg_class WHERE oid = to_regclass('${TABLE}') AND reltoastrelid <> 0")

        # cancel ANY autovacuum currently touching this table or its toast (not just anti-wraparound);
        # "% name" / "% name %" rather than "%name%", so public.tasks does not also hit public.tasks_archive
        AV_PIDS=$(psql ${PGARGS} -d "${DBNAME}" -Atc "SELECT pid FROM pg_stat_activity
            WHERE datname = '${DBNAME}' AND query LIKE 'autovacuum:%'
              AND (query LIKE '% ${FQ}' OR query LIKE '% ${FQ} %'
                   OR ('${TOAST}' <> '' AND (query LIKE '% ${TOAST}' OR query LIKE '% ${TOAST} %')))")
        for AVPID in ${AV_PIDS}; do
            echo "Cancelling autovacuum pid ${AVPID} on ${DBNAME}.${TABLE}"
            psql ${PGARGS} -d "${DBNAME}" -c "SELECT pg_cancel_backend(${AVPID})"
        done

        echo "Disabling autovacuum on ${TABLE} in ${DBNAME} for the duration of repack"
        psql ${PGARGS} -d "${DBNAME}" -c "ALTER TABLE ${TABLE} SET (autovacuum_enabled = false);" || return 1
        # shellcheck disable=SC2064  # expand now on purpose: the handler must name THIS shard
        trap "repack_av_reset '${DBNAME}' '${TABLE}'; exit 130" INT TERM

        echo "Running pg_repack for ${TABLE} in ${DBNAME}"
        pg_repack ${PGARGS2} -d "${DBNAME}" --table "${TABLE}" --no-kill-backend --wait-timeout=120
        REPACK_STATUS=$?

        trap - INT TERM
        echo "Re-enabling autovacuum on ${TABLE} in ${DBNAME}"
        repack_av_reset "${DBNAME}" "${TABLE}"

        [ ${REPACK_STATUS} -eq 0 ] || { echo "ОШИБКА: pg_repack ${DBNAME}.${TABLE} rc=${REPACK_STATUS}, остальные шарды не обработаны" >&2; return 1; }
    done
}

dbsize(){
    oid2name="${PG_BIN_PATH}/oid2name ${PGARGS2}"
    pg_data_path="${PG_DATA}"
    $oid2name | grep 'pg_default'| while read oid name tablespace; do
    size=`du -h -s $pg_data_path/$oid|cut -f1`
    echo "$size $name"
    done
}

top_tables() {
    if [ ! -z "${1}" ]; then
        DB=${1}
    else
        echo "ERROR :: Database not defined"
        exit 1
    fi
    [ ! -z "${SCHEMA}" ] || { SCHEMA='public'; }

    psql ${PGARGS} ${DB} -c "SELECT schemaname,tablename,
        pg_size_pretty(pg_relation_size(schemaname || '.' || tablename)) AS size_p,
        pg_total_relation_size(schemaname || '.' || tablename) AS size,
        pg_size_pretty(pg_total_relation_size(schemaname || '.' || tablename)) AS total_size_p,
        pg_total_relation_size(schemaname || '.' || tablename) - pg_relation_size(schemaname || '.' || tablename) AS index_size,
        (100*(pg_total_relation_size(schemaname || '.' || tablename) - pg_relation_size(schemaname || '.' || tablename)))/CASE WHEN pg_total_relation_size(schemaname || '.' || tablename) = 0 THEN 1 ELSE pg_total_relation_size(schemaname || '.' || tablename) END || '%' AS index_pct FROM pg_tables where schemaname = '${SCHEMA}' ORDER BY size DESC LIMIT 20"
}


case "$1" in
    truncate_all)
        truncate_all
    ;;
    truncate_tasks_history)
        truncate_tasks_history
    ;;
    partman_maintenance)
        partman_maintenance
    ;;
    check_bloat)
        check_bloat_tables
    ;;
    repack_shards)
        repack_shards "tasks"
    ;;
    dbsize)
        dbsize
    ;;
    top)
        top_tables "$2"
    ;;
	*)
	echo "Usage: ${0} { truncate_all | truncate_tasks_history | partman_maintenance | check_bloat | repack_shards | dbsize | top }"
esac
