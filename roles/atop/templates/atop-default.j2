# /etc/default/atop - managed by Ansible (Debian/Ubuntu)
# Debian's atop init reads these variable names (differ from RHEL /etc/sysconfig/atop).

# Interval between each sample in seconds (minimum 1)
INTERVAL={{ atop_interval }}

# Number of daily log files to keep
LOGGENERATIONS={{ atop_log_generations }}

# Directory for the binary log files
LOGPATH={{ atop_log_path }}

# Additional flags passed to the atop daemon
LOGOPTS="{{ atop_logo_opts }}"
