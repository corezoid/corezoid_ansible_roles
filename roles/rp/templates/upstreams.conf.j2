#jinja2: trim_blocks:True, lstrip_blocks:True
{{ ansible_managed | comment }}
# Reverse-proxy upstreams — rendered from rp_upstreams.
{% for up in rp_upstreams %}

upstream {{ up.name }} {
{% if up.method is defined %}
    {{ up.method }};
{% endif %}
{% for srv in up.servers %}
{% if srv is mapping %}
    server {{ srv.address }}{{ (' ' ~ srv.params) if srv.params is defined else '' }};
{% else %}
    server {{ srv }};
{% endif %}
{% endfor %}
{% if up.keepalive is defined %}
    keepalive {{ up.keepalive }};
{% endif %}
}
{% endfor %}
