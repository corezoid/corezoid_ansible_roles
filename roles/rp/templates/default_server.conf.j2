#jinja2: trim_blocks:True, lstrip_blocks:True
{{ ansible_managed | comment }}
# Catch-all default server — swallows requests with an unmatched Host header
# (scanners, bots hitting the raw IP). Returns 444 (connection closed, no body).

server {
    listen      80 default_server;
    listen      443 ssl default_server;
    server_name _;

    # Self-signed material so the TLS listener can start; never presented to
    # legitimate clients because no real server_name matches here.
    ssl_certificate     {{ rp_ssl_dir }}/default_server.crt;
    ssl_certificate_key {{ rp_ssl_dir }}/default_server.key;

    return 444;
}
