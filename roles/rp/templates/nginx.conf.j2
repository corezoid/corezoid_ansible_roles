#jinja2: trim_blocks:True, lstrip_blocks:True
{{ ansible_managed | comment }}
# Managed by Ansible role: rp — do not edit by hand.

user  {{ rp_user }};
worker_processes  {{ rp_worker_processes }};
worker_rlimit_nofile {{ rp_worker_rlimit_nofile }};

error_log  {{ rp_error_log }};
pid        {{ rp_pid_file }};

events {
    worker_connections  {{ rp_worker_connections }};
    multi_accept        {{ rp_multi_accept }};
    use                 epoll;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    server_names_hash_bucket_size {{ rp_server_names_hash_bucket_size }};
    types_hash_max_size           {{ rp_types_hash_max_size }};
    types_hash_bucket_size        {{ rp_types_hash_bucket_size }};
    server_tokens                 {{ rp_server_tokens }};

    # ---- logging --------------------------------------------------------
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    log_format  up_log '$server_addr\t$server_port\t$remote_addr\t$time_iso8601\t'
                       'forward-to $upstream_addr\t$request\t$status\t$body_bytes_sent\t'
                       '$request_time\t$upstream_response_time\t$http_referer\t'
                       '$http_user_agent\t$http_cookie\t$host';

    access_log  {{ rp_access_log }}  {{ rp_log_format_name }};

    # ---- websocket connection-upgrade map (used by proxy snippet/macro) -
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # ---- connection / buffer tuning ------------------------------------
    sendfile           {{ rp_sendfile }};
    tcp_nopush         {{ rp_tcp_nopush }};
    tcp_nodelay        {{ rp_tcp_nodelay }};
    keepalive_timeout  {{ rp_keepalive_timeout }};
    keepalive_requests {{ rp_keepalive_requests }};
    reset_timedout_connection {{ rp_reset_timedout_connection }};
    client_body_timeout    {{ rp_client_body_timeout }};
    client_header_timeout  {{ rp_client_header_timeout }};
    send_timeout           {{ rp_send_timeout }};

    client_max_body_size        {{ rp_client_max_body_size }};
    client_body_buffer_size     {{ rp_client_body_buffer_size }};
    large_client_header_buffers {{ rp_large_client_header_buffers }};

    # ---- real client IP behind a load balancer -------------------------
    real_ip_header  {{ rp_real_ip_header }};
{% for cidr in rp_set_real_ip_from %}
    set_real_ip_from {{ cidr }};
{% endfor %}

    # ---- rate / connection limiting zones ------------------------------
{% for z in rp_limit_req_zones %}
    limit_req_zone {{ z.key }} zone={{ z.name }}:{{ z.size }} rate={{ z.rate }};
{% endfor %}
{% for z in rp_limit_conn_zones %}
    limit_conn_zone {{ z.key }} zone={{ z.name }}:{{ z.size }};
{% endfor %}

    # ---- gzip -----------------------------------------------------------
    gzip            {{ rp_gzip }};
    gzip_comp_level {{ rp_gzip_comp_level }};
    gzip_min_length {{ rp_gzip_min_length }};
    gzip_proxied    any;
    gzip_vary       on;
    gzip_types      {{ rp_gzip_types | join(' ') }};

    # ---- per-site config -----------------------------------------------
    include /etc/nginx/conf.d/*.conf;
}
