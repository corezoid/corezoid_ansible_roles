{{ ansible_managed | comment }}
# Reusable reverse-proxy header snippet — include inside a location{} block
# when you write a raw location and want the standard forwarded headers without
# repeating them. (The render_location macro emits these automatically.)

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $connection_upgrade;
