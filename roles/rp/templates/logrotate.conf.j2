#jinja2: trim_blocks:True, lstrip_blocks:True
{{ ansible_managed | comment }}
# NGINX log rotation — managed by Ansible role: rp.
# Policy: keep {{ rp_logrotate_rotate }} {{ rp_logrotate_frequency }} files;
# archive rotated logs{{ ', newest stays uncompressed' if rp_logrotate_delaycompress else '' }}; delete anything older.

{{ rp_logrotate_path }} {
    {{ rp_logrotate_frequency }}
    rotate {{ rp_logrotate_rotate }}
    missingok
    notifempty
{% if rp_logrotate_compress %}
    compress
{% if rp_logrotate_delaycompress %}
    delaycompress
{% endif %}
{% endif %}
    create {{ rp_logrotate_create_mode }} {{ rp_logrotate_create_user }} {{ rp_logrotate_create_group }}
    sharedscripts
    postrotate
        /bin/kill -USR1 `cat {{ rp_pid_file }} 2>/dev/null` 2>/dev/null || true
    endscript
}
