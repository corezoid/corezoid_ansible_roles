[aws-corezoid]
name=Corezoid
baseurl={{ corezoid_repo_baseurl | default('https://' ~ (corezoid_repo_domain | default('repo.middleware.biz')) ~ '/' ~ (yum_s3_bucket | default('corezoid')) ~ '/' ~ yum_s3_bucket_prefix) }}
enabled=1
{% if corezoid_repo_domain is defined or corezoid_release < '5.3' %}
gpgcheck=0
{% else %}
gpgcheck=1
gpgkey={{ corezoid_repo_gpgkey }}
{% endif %}
priority=5
